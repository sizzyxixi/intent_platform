# 本地开发用（复制为 backend/.env）；所有变量均以 IP_ 开头
IP_ENV=development
IP_DATABASE_URL=postgresql+psycopg://intent:intent@127.0.0.1:5432/intent
IP_SECRET_KEY=dev-insecure-change-me-0123456789abcdef
IP_ADMIN_USERNAME=admin
IP_ADMIN_PASSWORD=admin123456
IP_PUBLIC_BASE_URL=http://localhost:5173
IP_COOKIE_SECURE=false
IP_RATE_LIMIT_PER_MINUTE=60
IP_IDEMPOTENCY_TTL_HOURS=24
IP_MAX_BATCH=100
IP_MAX_UPLOAD_MB=50
IP_SEARCH_BACKEND=postgres
IP_CORS_ORIGINS=
IP_LOG_LEVEL=INFO
# 可选：由后端直接托管前端构建产物（不用 nginx 时）
# IP_FRONTEND_DIST=../frontend/dist
# 可选：接入说明 / openapi 文档目录（默认仓库 docs/）
# IP_DOCS_DIR=../docs
