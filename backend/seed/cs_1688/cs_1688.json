 "tool_map": {
  "get_stock_eta": {
   "tools": [
    "xclaw_platform_alibaba_product_get"
   ],
   "confidence": "中",
   "why": "1688 开放平台「获取商品」(platform alibaba product get) 返回商品及 SKU 的可售数量；没有预计到货日 / 截单发货规则字段，这两项仍缺接口"
  },
  "get_price_quote": {
   "tools": [
    "xclaw_platform_alibaba_product_get"
   ],
   "confidence": "中",
   "why": "同一「获取商品」返回区间（阶梯）报价；包邮门槛、活动价不在返回里，报价时按数量对应档位"
  },
  "apply_change_price": {
   "tools": [
    "xclaw_platform_alibaba_trade_order_modifyorderprice_call"
   ],
   "confidence": "高",
   "why": "「修改订单价格」(trade-order-modifyorderprice) 直接改 1688 订单价；接口要求运费、改价明细以「分」为单位，需由客服按目标价换算并确认；已标记需确认"
  },
  "lock_or_hold_stock": {
   "tools": [],
   "confidence": "",
   "why": "目录中没有「占仓 / 锁库存」接口（只有修改库存 product-modifystock、批量改库存，语义不同，不能代替占仓）"
  },
  "ship_urge_track": {
   "tools": [
    "xclaw_platform_alibaba_trade_getlogisticstraceinfo_sellerview_v1_call"
   ],
   "confidence": "高",
   "why": "「获取交易订单的物流跟踪信息（卖家视角）」(trade-getlogisticstraceinfo-sellerview-v1) 按订单号返回运单与物流节点"
  },
  "aftersale_refund": {
   "tools": [
    "xclaw_platform_alibaba_trade_refund_sellerview_query"
   ],
   "confidence": "中",
   "why": "「查询退款单详情-根据订单ID（卖家视角）」(trade-refund-sellerview query) 返回退款进度/状态；同意退货、补寄、换货等操作接口存在但属写操作，本期只绑查询"
  },
  "get_spec_media": {
   "tools": [
    "xclaw_platform_alibaba_product_get"
   ],
   "confidence": "中（资质 / 发票低）",
   "why": "「获取商品」返回商品属性、图片；证照 / 资质、开票类型不在返回里"
  },
  "get_custom_moq": {
   "tools": [
    "xclaw_platform_alibaba_product_get"
   ],
   "confidence": "低",
   "why": "「获取商品」只能给起订量；「查询定制服务」(custom-query-bycate) 需要一二三级类目 ID，无法从对话槽位取得，未绑定；打样费、打样周期无接口"
  },
  "clarify_slot": {
   "tools": [],
   "confidence": "",
   "why": "Router 动作：由必填槽位追问话术 + 空间「识别设置」中的澄清实现，不是外部工具"
