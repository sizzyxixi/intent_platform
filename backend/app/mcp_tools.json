[
 {
  "name": "list_intents",
  "description": "列出当前空间的意图，或读取元数据：view=spaces 读空间列表，view=taxonomy 读合法的 L1/L2，view=slots 读本空间槽位列表，view=recognition 读本空间的空间设置。写入前先读 spaces、taxonomy 和 slots。只读。",
  "inputSchema": {
   "type": "object",
   "properties": {
    "space": {
     "type": "string",
     "description": "空间 ID，如 cs、mc；不传则用 Key 绑定的空间"
    },
    "view": {
     "type": "string",
     "enum": [
      "intents",
      "taxonomy",
      "slots",
      "spaces",
      "recognition"
     ],
     "default": "intents"
    },
    "l1": {
     "type": "string",
     "description": "L1 编码，如 STOCK、DESIGN"
    },
    "l2": {
     "type": "string",
     "description": "L2 名称"
    },
    "status": {
     "type": "string",
     "enum": [
      "草稿",
      "启用",
      "停用"
     ]
    },
    "q": {
     "type": "string",
     "description": "关键词，匹配编码/名称/意图描述/例句"
    },
    "updated_after": {
     "type": "string",
     "format": "date-time"
    },
    "page_size": {
     "type": "integer",
     "minimum": 1,
     "maximum": 100,
     "default": 50
    }
   }
  }
 },
 {
  "name": "get_intent",
  "description": "按编码读取单个意图的完整信息（例句、槽位、关联知识及用途、工具映射）。只读。",
  "inputSchema": {
   "type": "object",
   "required": [
    "code"
   ],
   "properties": {
    "space": {
     "type": "string"
    },
    "code": {
     "type": "string",
     "pattern": "^[A-Z]{1,4}\\.[A-Z]+\\.[A-Z0-9_]+$"
    }
   }
  }
 },
 {
  "name": "upsert_intents",
  "description": "批量写回当前空间的意图，结果一律为草稿。mode 只用 merge；不能启用、不能删除、不能覆盖已启用意图。槽位名用本空间已有槽位的英文名，不要建同义槽位。单次最多 100 条，必须提供 idempotency_key。",
  "inputSchema": {
   "type": "object",
   "required": [
    "mode",
    "intents",
    "idempotency_key"
   ],
   "properties": {
    "space": {
     "type": "string"
    },
    "mode": {
     "type": "string",
     "enum": [
      "merge"
     ]
    },
    "idempotency_key": {
     "type": "string",
     "maxLength": 64
    },
    "intents": {
     "type": "array",
     "minItems": 1,
     "maxItems": 100,
     "items": {
      "type": "object",
      "required": [
       "code",
       "name",
       "l1",
       "l2",
       "description",
       "examples"
      ],
      "properties": {
       "code": {
        "type": "string",
        "pattern": "^[A-Z]{1,4}\\.[A-Z]+\\.[A-Z0-9_]+$"
       },
       "name": {
        "type": "string",
        "maxLength": 30
       },
       "l1": {
        "type": "string"
       },
       "l2": {
        "type": "string"
       },
       "description": {
        "type": "string",
        "minLength": 15,
        "description": "意图描述：用户想做什么；什么算；什么不算（易混淆意图）"
       },
       "examples": {
        "type": "array",
        "minItems": 3,
        "items": {
         "type": "string"
        }
       },
       "slots": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "name",
          "required"
         ],
         "properties": {
          "name": {
           "type": "string",
           "description": "本空间槽位英文名"
          },
          "required": {
           "type": "boolean"
          },
          "ask": {
           "type": "string",
           "description": "留空则继承该槽位默认追问话术"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 },
 {
  "name": "search_knowledge",
  "description": "在全部知识库（全平台通用）中按问题检索最相关的知识切片，可按平台/站点/语言/类目标签过滤，返回相似度、标签和已关联意图。只读。",
  "inputSchema": {
   "type": "object",
   "required": [
    "query"
   ],
   "properties": {
    "kb_id": {
     "type": "string",
     "description": "不传则检索全部知识库"
    },
    "query": {
     "type": "string"
    },
    "platform": {
     "type": "string",
     "description": "如 TikTok、Shopee、Amazon、1688"
    },
    "site": {
     "type": "string",
     "description": "如 US、VN、CN"
    },
    "language": {
     "type": "string",
     "description": "如 en、vi、zh"
    },
    "category": {
     "type": "string"
    },
    "top_k": {
     "type": "integer",
     "minimum": 1,
     "maximum": 20,
     "default": 5
    }
   }
  }
 },
 {
  "name": "import_knowledge",
  "description": "向已有知识库导入文件（异步构建）。表格库表头必须完全一致；与已有文档同名/同内容时默认返回冲突并列出受影响意图，需运营确认后才能 overwrite=true。",
  "inputSchema": {
   "type": "object",
   "required": [
    "kb_id",
    "files",
    "idempotency_key"
   ],
   "properties": {
    "kb_id": {
     "type": "string"
    },
    "idempotency_key": {
     "type": "string",
     "maxLength": 64
    },
    "overwrite": {
     "type": "boolean",
     "default": false
    },
    "files": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "type": "object",
      "required": [
       "name",
       "content_base64"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "content_base64": {
        "type": "string"
       }
      }
     }
    }
   }
  }
 },
 {
  "name": "list_tools",
  "description": "列出全部工具（外部：API 接口 / MCP 工具 / CLI 命令 / 技能·工作流；以及平台内置工具）及入参，用于在意图中准备对应槽位。全局，不区分空间。只读；不能注册或调用工具。",
  "inputSchema": {
   "type": "object",
   "properties": {
    "source": {
     "type": "string",
     "enum": [
      "external",
      "builtin"
     ]
    },
    "q": {
     "type": "string"
    },
    "type": {
     "type": "string",
     "enum": [
      "http",
      "mcp",
      "cli",
      "skill"
     ]
    }
   }
  }
 }
]