# docker compose 使用的环境变量（复制为 deploy/.env 后修改）
POSTGRES_USER=intent
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=intent
# 会话签名与密钥加密用，至少 32 位随机字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
IP_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
IP_ADMIN_USERNAME=admin
IP_ADMIN_PASSWORD=change-me-admin-password
# 对外访问地址（出现在接入说明、MCP 配置示例和种子数据中的 URL）
IP_PUBLIC_BASE_URL=http://localhost:8080
# 通过 HTTPS 访问时设为 true
IP_COOKIE_SECURE=false
IP_RATE_LIMIT_PER_MINUTE=60
# 首次启动是否导入 demo 种子数据（空库时才导入）
SEED_DEMO=true
HTTP_PORT=8080
